// ---------------------------------------------------------------------
// Streaming parser for the ESP32's fixed-format JSON reply -- replaces an
// earlier version that buffered the WHOLE line (up to 420 bytes) before
// parsing it. That buffer was a major contributor to this sketch blowing
// its 2KB RAM budget. Since the ESP32 always sends fields in the exact
// same order --
//   {"class":"...","confidence":0.NN,"feat":[n,n,...,n]}\n
// -- there's no need to hold the whole line in memory at once. This reads
// and consumes it directly off the wire, field by field, using only a few
// bytes of scratch space at a time (a numeric accumulator, max ~4 bytes),
// regardless of how long the class name or feat array is.
// ---------------------------------------------------------------------

// Reads chars into outBuf until `terminator` is seen (which is consumed
// but not stored) or `deadline` (an absolute millis() value) passes.
// Truncates silently if outBuf fills before the terminator -- fine here
// since ScanResult.className is intentionally shorter than some of the
// real class label strings.
bool readUntilChar(char terminator, char *outBuf, int outBufLen, unsigned long deadline) {
  int idx = 0;
  while ((long)(millis() - deadline) < 0) {
    if (espLink.available()) {
      char c = espLink.read();
      if (c == terminator) {
        if (outBuf && outBufLen > 0) outBuf[idx < outBufLen - 1 ? idx : outBufLen - 1] = '\0';
        return true;
      }
      if (outBuf && idx < outBufLen - 1) outBuf[idx++] = c;
    }
  }
  return false; // timed out
}

// Consumes exactly the given literal string from the wire, character by
// character, verifying each one matches. Used for the fixed JSON
// punctuation/keys we already know are coming.
bool expectLiteral(const char *literal, unsigned long deadline) {
  for (size_t i = 0; literal[i] != '\0'; i++) {
    while (!espLink.available()) {
      if ((long)(millis() - deadline) >= 0) return false;
    }
    if (espLink.read() != literal[i]) return false;
  }
  return true;
}

bool receiveScanResult(ScanResult &out) {
  out.valid = false;
  unsigned long deadline = millis() + 8000UL;

  if (!expectLiteral("{\"class\":\"", deadline)) return false;
  if (!readUntilChar('"', out.className, sizeof(out.className), deadline)) return false;
  if (!expectLiteral("\",\"confidence\":", deadline)) return false;

  char confBuf[8]; // enough for "0.91" etc -- tiny, stack cost is negligible
  if (!readUntilChar(',', confBuf, sizeof(confBuf), deadline)) return false;
  out.confidence = atof(confBuf);

  if (!expectLiteral("\"feat\":[", deadline)) return false;

  for (int i = 0; i < FEAT_LEN; i++) {
    char numBuf[5]; // "255\0" max -- also negligible
    char terminator = (i < FEAT_LEN - 1) ? ',' : ']';
    if (!readUntilChar(terminator, numBuf, sizeof(numBuf), deadline)) return false;
    out.feat[i] = (int16_t)atoi(numBuf);
  }

  expectLiteral("}", deadline); // best-effort -- everything we need is already parsed either way

  out.valid = true;
  return true;
}

// Phase 4: real fixed-point logistic regression, trained via
// train_tiny_model.py and exported to tiny_model.h. Replaces the earlier
// mean-threshold stub now that a real model exists.
//
// score_fixed = bias + sum(weight[i] * feature[i])   -- integer math only
// class = "diseased" if (score_fixed / MODEL_SCALE) > 0 else "healthy"
//   (valid because logistic regression's decision boundary is exactly
//    intercept + sum(coef*x) == 0 -- sign alone gives the class)
#if FEATURE_COUNT != FEAT_LEN
#error "tiny_model.h's FEATURE_COUNT does not match this sketch's FEAT_LEN -- retrain or fix GRID_SIZE mismatch before flashing."
#endif

bool tinyModelVerdict(const int16_t *feat, int len) {
  int32_t acc = MODEL_BIAS;
  for (int i = 0; i < len; i++) {
    int16_t w = (int16_t)pgm_read_word(&MODEL_WEIGHTS[i]); // PROGMEM read, not plain indexing
    acc += (int32_t)w * (int32_t)feat[i];
  }
  float score = (float)acc / (float)MODEL_SCALE;
  return score > 0.0f; // true = diseased
}

void drawResultScreen(const ScanResult &r, const char *zoneId) {
  tft.fillScreen(COLOR_BG);

  bool primaryDiseased = (strcmp(r.className, "healthy") != 0);
  bool secondaryDiseased = tinyModelVerdict(r.feat, FEAT_LEN);
  bool agree = (primaryDiseased == secondaryDiseased);

  uint16_t headlineColor = primaryDiseased ? COLOR_DISEASED : COLOR_HEALTHY;

  tft.setTextColor(headlineColor);
  tft.setTextSize(2);
  tft.setCursor(10, 15);
  tft.println(primaryDiseased ? r.className : "Healthy");

  tft.setTextColor(COLOR_TEXT);
  tft.setTextSize(1);
  tft.setCursor(10, 45);
  tft.print("Confidence: ");
  tft.print(r.confidence * 100.0f, 1);
  tft.println("%");

  tft.setCursor(10, 60);
  tft.print("Zone: ");
  tft.println(zoneId);

  tft.setCursor(10, 78);
  tft.setTextColor(agree ? COLOR_HEALTHY : ILI9341_YELLOW);
  tft.print("On-Arduino verified: ");
  tft.println(agree ? "OK (agree)" : "MISMATCH -- rescan");
  tft.setTextColor(COLOR_TEXT);

  // Quick prior-reading hint for this zone, ahead of the full Phase 7 trend
  // graph -- only shows if there's at least one earlier reading stored.
  ScanRecord prev;
  tft.setCursor(10, 96);
  if (getPreviousReading(zoneId, prev)) {
    tft.setTextColor(COLOR_MUTED);
    tft.print("Previous reading: ");
    tft.print(prev.confidence * 100.0f, 1);
    tft.print("% (");
    tft.print(prev.classNameTrunc);
    tft.println(")");
  } else {
    tft.setTextColor(COLOR_MUTED);
    tft.println("First reading for this zone -- no history yet.");
  }
  tft.setTextColor(COLOR_TEXT);

  tft.setCursor(10, 114);
  tft.setTextColor(COLOR_MUTED);
  tft.println("(secondary verdict: on-Arduino TinyML model)");
  tft.setTextColor(COLOR_TEXT);

  tft.setCursor(10, 280);
  tft.setTextColor(COLOR_MUTED);
  tft.println("Tap anywhere to return to idle screen");
}

// ---------------------------------------------------------------------
// Dashboard protocol (over the Uno's existing USB Serial link -- NOT
// espLink, which is the separate SoftwareSerial link to the ESP32-S3-CAM).
// Added because the physical touchscreen is currently non-functional and
// there is no other way to trigger a scan or see a result. See
// WEB_DASHBOARD.md for the PC-side design this feeds.
//
// Outbound, printed once per successfully-parsed scan:
//   DASH:{"zone":"B4","class":"...","confidence":0.91,"tinyVerdict":"healthy","agree":true,"ts":123456}
// Inbound, checked every loop() alongside touch:
//   DASH_SCAN:B4\n   -- triggers a scan of zone B4 exactly as if tapped
//                       on the (currently broken) zone-pick grid.
// ---------------------------------------------------------------------

void emitDashLine(const char *zoneId, const ScanResult &r, bool tinyDiseased, bool agree) {
  Serial.print("DASH:{\"zone\":\"");
  Serial.print(zoneId);
  Serial.print("\",\"class\":\"");
  Serial.print(r.className);
  Serial.print("\",\"confidence\":");
  Serial.print(r.confidence, 2);
  Serial.print(",\"tinyVerdict\":\"");
  Serial.print(tinyDiseased ? "diseased" : "healthy");
  Serial.print("\",\"agree\":");
  Serial.print(agree ? "true" : "false");
  Serial.print(",\"ts\":");
  Serial.print(millis());
  Serial.println("}");
}

// Checks the USB Serial link for a "DASH_SCAN:<zoneId>" command. Returns
// true and fills outZoneId if one was received. Non-blocking -- call once
// per loop() iteration.
bool readDashScanCommand(char *outZoneId) {
  static char buf[16];
  static size_t len = 0;

  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n') {
      buf[len] = '\0';
      len = 0;
      const char *prefix = "DASH_SCAN:";
      if (strncmp(buf, prefix, strlen(prefix)) == 0) {
        const char *zonePart = buf + strlen(prefix);
        strncpy(outZoneId, zonePart, 3);
        outZoneId[3] = '\0';
        // Trim any trailing \r from CRLF-sending terminals.
        for (int i = 0; i < 4; i++) if (outZoneId[i] == '\r') outZoneId[i] = '\0';
        return true;
      }
      return false; // some other line -- ignore, not a DASH_SCAN command
    }
    if (len < sizeof(buf) - 1) {
      buf[len++] = c;
    } else {
      len = 0; // overflow guard
    }
  }
  return false;
}

void doScanFlow(const char *zoneId) {
  currentScreen = SCREEN_SCANNING;
  drawScanningScreen(zoneId);

  while (espLink.available()) espLink.read();

  espLink.print("SCAN\n");
  Serial.print("[TX -> ESP32] SCAN  (zone ");
  Serial.print(zoneId);
  Serial.println(")");

  ScanResult result;
  bool gotResult = receiveScanResult(result);

  if (!gotResult) {
    tft.fillScreen(COLOR_BG);
    tft.setTextColor(COLOR_DISEASED);
    tft.setTextSize(2);
    tft.setCursor(10, 20);
    tft.println("Scan failed");
    tft.setTextSize(1);
    tft.setTextColor(COLOR_MUTED);
    tft.setCursor(10, 50);
    tft.println("No/bad reply from ESP32-S3-CAM. Check UART wiring (D2/D3, GND).");
    tft.setCursor(10, 280);
    tft.println("Tap anywhere to return to idle screen");
    currentScreen = SCREEN_RESULT;
    return;
  }

  Serial.print("[RX <- ESP32] class=");
  Serial.print(result.className);
  Serial.print(" confidence=");
  Serial.println(result.confidence, 2);

  // Only store valid, successfully-parsed readings.
  addScanToHistory(zoneId, result.className, result.confidence);
  printZoneHistory(zoneId); // acceptance-test verification output

  bool primaryDiseased = (strcmp(result.className, "healthy") != 0);
  bool tinyDiseased = tinyModelVerdict(result.feat, FEAT_LEN);
  emitDashLine(zoneId, result, tinyDiseased, primaryDiseased == tinyDiseased);


  drawResultScreen(result, zoneId);
  currentScreen = SCREEN_RESULT;
}

void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("=== Crop Sentinel AI -- Phase 6: zone tagging + history ===");

  espLink.begin(ESP_BAUD);

  tft.begin();
  tft.setRotation(0);

  touch.begin();
  touch.setRotation(tft.getRotation());

  drawIdleScreen();
  Serial.println("[OK] Idle screen drawn. Tap 'Scan Crop' to tag a zone and start a scan.");
}

void loop() {
  // Remote trigger from the web dashboard -- works even with the
  // touchscreen non-functional. Checked every iteration, independent of
  // touch state, except while a scan is already in progress.
  if (currentScreen != SCREEN_SCANNING) {
    char remoteZoneId[4];
    if (readDashScanCommand(remoteZoneId)) {
      strncpy(currentZoneId, remoteZoneId, sizeof(currentZoneId));
      Serial.print("[DASH] Remote scan trigger for zone ");
      Serial.println(currentZoneId);
      doScanFlow(currentZoneId);
    }
  }

  if (touch.tirqTouched() && touch.touched()) {
    TS_Point p = touch.getPoint();
    int16_t x = map(p.x, TS_MINX, TS_MAXX, 0, tft.width());
    int16_t y = map(p.y, TS_MINY, TS_MAXY, 0, tft.height());

    if (currentScreen == SCREEN_IDLE) {
      if (touchInsideButton(x, y)) {
        currentScreen = SCREEN_ZONE_PICK;
        drawZonePickScreen();
      }
    } else if (currentScreen == SCREEN_ZONE_PICK) {
      char zoneId[4];
      if (zonePickTouchHit(x, y, zoneId)) {
        strncpy(currentZoneId, zoneId, sizeof(currentZoneId));
        doScanFlow(currentZoneId);
      }
    } else if (currentScreen == SCREEN_RESULT) {
      delay(150); // crude debounce
      currentScreen = SCREEN_IDLE;
      drawIdleScreen();
    }
    // SCREEN_SCANNING ignores touch -- doScanFlow() blocks until reply/timeout.
  }
}
