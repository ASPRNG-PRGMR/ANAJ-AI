// ---------------------------------------------------------------------
// Zone grid geometry -- 5 columns (A-E) x 5 rows (1-5) = 25 zones, e.g.
// "B4". Matches the grid-cell tagging style from §6's protocol examples.
// If your field layout wants Row/Plant numbers instead of a letter grid,
// only zoneIdForCell() below needs to change -- everything downstream
// (history, display) just treats zone IDs as opaque short strings.
// ---------------------------------------------------------------------
#define GRID_COLS 5
#define GRID_ROWS 5
#define GRID_X 15
#define GRID_Y 55
#define GRID_CELL 40
#define GRID_GAP 6

// ---------------------------------------------------------------------
// History storage -- fixed-size ring buffer per zone, per the RAM budget
// note in §4.3. Tune these two constants first if you hit RAM trouble.
// ---------------------------------------------------------------------
#define MAX_ZONES        3   // distinct zones remembered at once (oldest zone evicted if full)
#define SCANS_PER_ZONE    3  // ring buffer depth per zone
#define CLASS_NAME_LEN   16  // matches ScanResult.className's size -- no point storing more than that ever holds

struct ScanRecord {
  char classNameTrunc[CLASS_NAME_LEN];
  float confidence;
  unsigned long timestampMs; // millis() since boot -- see note in printZoneHistory()
  bool used;
};

struct ZoneSlot {
  char zoneId[4];             // e.g. "B4\0"
  bool inUse;
  ScanRecord scans[SCANS_PER_ZONE];
  uint8_t nextWriteIndex;     // ring buffer write cursor
  uint8_t count;              // how many of scans[] are actually populated (<= SCANS_PER_ZONE)
};

ZoneSlot zoneHistory[MAX_ZONES];
uint8_t zoneCount = 0; // how many of zoneHistory[] slots are in use

enum AppScreen { SCREEN_IDLE, SCREEN_ZONE_PICK, SCREEN_SCANNING, SCREEN_RESULT };
AppScreen currentScreen = SCREEN_IDLE;

char currentZoneId[4] = "";

struct ScanResult {
  char className[16];
  float confidence;
  int16_t feat[FEAT_LEN];
  bool valid;
};

// =======================================================================
// History storage
// =======================================================================

// Finds an existing zone slot, or creates one if there's room. Returns
// nullptr only if MAX_ZONES is full and zoneId isn't already tracked --
// in that case we just don't store history for this scan rather than
// silently overwriting a different zone's data (see note in addScanToHistory).
ZoneSlot *findOrCreateZone(const char *zoneId) {
  for (uint8_t i = 0; i < zoneCount; i++) {
    if (strcmp(zoneHistory[i].zoneId, zoneId) == 0) {
      return &zoneHistory[i];
    }
  }
  if (zoneCount < MAX_ZONES) {
    ZoneSlot &z = zoneHistory[zoneCount];
    strncpy(z.zoneId, zoneId, sizeof(z.zoneId) - 1);
    z.zoneId[sizeof(z.zoneId) - 1] = '\0';
    z.inUse = true;
    z.nextWriteIndex = 0;
    z.count = 0;
    for (uint8_t s = 0; s < SCANS_PER_ZONE; s++) z.scans[s].used = false;
    zoneCount++;
    return &zoneHistory[zoneCount - 1];
  }
  return nullptr; // MAX_ZONES exhausted and this is a brand-new zone
}

void addScanToHistory(const char *zoneId, const char *className, float confidence) {
  ZoneSlot *z = findOrCreateZone(zoneId);
  if (!z) {
    Serial.println("[WARN] MAX_ZONES reached -- not tracking history for this new zone. Raise MAX_ZONES if you need more concurrent zones.");
    return;
  }

  ScanRecord &rec = z->scans[z->nextWriteIndex];
  strncpy(rec.classNameTrunc, className, CLASS_NAME_LEN - 1);
  rec.classNameTrunc[CLASS_NAME_LEN - 1] = '\0';
  rec.confidence = confidence;
  rec.timestampMs = millis();
  rec.used = true;

  z->nextWriteIndex = (z->nextWriteIndex + 1) % SCANS_PER_ZONE;
  if (z->count < SCANS_PER_ZONE) z->count++;
}

// Prints a zone's history oldest -> newest, purely for demo/dev verification
// of the Phase 6 acceptance test (scan same zone twice, confirm both
// readings retrievable and correctly time-ordered).
//
// NOTE: timestampMs is millis() since the Uno last booted, NOT wall-clock
// time -- there's no RTC in this build. It's still monotonic and correct
// for ordering within a single power-on session, which is all the
// acceptance test asks for. Add an RTC module later if you need real
// wall-clock timestamps across power cycles.
void printZoneHistory(const char *zoneId) {
  ZoneSlot *z = nullptr;
  for (uint8_t i = 0; i < zoneCount; i++) {
    if (strcmp(zoneHistory[i].zoneId, zoneId) == 0) {
      z = &zoneHistory[i];
      break;
    }
  }
  if (!z) {
    Serial.println("[HISTORY] (no history found for this zone)");
    return;
  }

  Serial.print("[HISTORY] Zone ");
  Serial.print(zoneId);
  Serial.print(" -- ");
  Serial.print(z->count);
  Serial.println(" reading(s), oldest first:");

  // Ring buffer readout in chronological order: start at the oldest slot,
  // which is nextWriteIndex when the buffer is full, or 0 when it isn't.
  uint8_t startIdx = (z->count < SCANS_PER_ZONE) ? 0 : z->nextWriteIndex;
  for (uint8_t n = 0; n < z->count; n++) {
    uint8_t idx = (startIdx + n) % SCANS_PER_ZONE;
    ScanRecord &rec = z->scans[idx];
    if (!rec.used) continue;
    Serial.print("  t=");
    Serial.print(rec.timestampMs);
    Serial.print("ms  class=");
    Serial.print(rec.classNameTrunc);
    Serial.print("  confidence=");
    Serial.println(rec.confidence, 2);
  }
}

// Returns the previous (second-most-recent) reading for a zone, if any --
// used to show a quick "up from X%" hint on the result screen ahead of the
// full Phase 7 trend graph. Returns false if there's no prior reading.
bool getPreviousReading(const char *zoneId, ScanRecord &out) {
  for (uint8_t i = 0; i < zoneCount; i++) {
    if (strcmp(zoneHistory[i].zoneId, zoneId) != 0) continue;
    ZoneSlot &z = zoneHistory[i];
    if (z.count < 2) return false; // only the just-added reading exists
    // Most recent is at (nextWriteIndex - 1); previous is one before that.
    int lastIdx = (z.nextWriteIndex + SCANS_PER_ZONE - 1) % SCANS_PER_ZONE;
    int prevIdx = (lastIdx + SCANS_PER_ZONE - 1) % SCANS_PER_ZONE;
    if (!z.scans[prevIdx].used) return false;
    out = z.scans[prevIdx];
    return true;
  }
  return false;
}

// =======================================================================
// UI: zone grid picker
// =======================================================================

void zoneIdForCell(uint8_t col, uint8_t row, char *outBuf) {
  outBuf[0] = 'A' + col;
  outBuf[1] = '1' + row;
  outBuf[2] = '\0';
}

void drawZonePickScreen() {
  tft.fillScreen(COLOR_BG);
  tft.setTextColor(COLOR_TEXT);
  tft.setTextSize(2);
  tft.setCursor(10, 15);
  tft.println("Tag Zone");
  tft.setTextSize(1);
  tft.setTextColor(COLOR_MUTED);
  tft.setCursor(10, 38);
  tft.println("Tap a cell to select and start scanning");
  tft.setTextColor(COLOR_TEXT);

  for (uint8_t row = 0; row < GRID_ROWS; row++) {
    for (uint8_t col = 0; col < GRID_COLS; col++) {
      int x = GRID_X + col * (GRID_CELL + GRID_GAP);
      int y = GRID_Y + row * (GRID_CELL + GRID_GAP);
      tft.fillRoundRect(x, y, GRID_CELL, GRID_CELL, 4, COLOR_GRID_CELL);

      char zoneId[4];
      zoneIdForCell(col, row, zoneId);
      tft.setTextColor(COLOR_GRID_TX);
      tft.setTextSize(1);
      // Rough centering for a 2-char label in a GRID_CELL-wide box.
      tft.setCursor(x + GRID_CELL / 2 - 6, y + GRID_CELL / 2 - 4);
      tft.println(zoneId);
    }
  }
}

// Returns true and fills outZoneId if (x,y) landed on a grid cell.
bool zonePickTouchHit(int16_t x, int16_t y, char *outZoneId) {
  int gridWidth = GRID_COLS * (GRID_CELL + GRID_GAP) - GRID_GAP;
  int gridHeight = GRID_ROWS * (GRID_CELL + GRID_GAP) - GRID_GAP;
  if (x < GRID_X || x > GRID_X + gridWidth || y < GRID_Y || y > GRID_Y + gridHeight) {
    return false;
  }
  int relX = x - GRID_X;
  int relY = y - GRID_Y;
  int col = relX / (GRID_CELL + GRID_GAP);
  int row = relY / (GRID_CELL + GRID_GAP);
  // Reject taps that landed in the gap between cells.
  if (relX % (GRID_CELL + GRID_GAP) > GRID_CELL) return false;
  if (relY % (GRID_CELL + GRID_GAP) > GRID_CELL) return false;
  if (col >= GRID_COLS || row >= GRID_ROWS) return false;

  zoneIdForCell(col, row, outZoneId);
  return true;
}

